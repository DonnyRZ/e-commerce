# Runtime
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
ENFORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO

# Checkout remains disabled until a payment method is selected and implemented.
CHECKOUT_ENABLED=false
# Telegram cart inquiries are disabled until the webhook and connected
# Business account have been verified. Keep both credentials server-side.
TELEGRAM_INQUIRIES_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STORE_USERNAME=CantikByIndonesia
TELEGRAM_BOT_USERNAME=MuslimahCantikBot
SHIPPING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Media (local persistent volume is free; S3-compatible storage is optional)
MEDIA_STORAGE=local
MEDIA_ROOT=./uploads
PAYMENT_EVIDENCE_ROOT=./payment-evidence
PAYMENT_EVIDENCE_MAX_BYTES=8388608
SHIPPING_DOCUMENT_ROOT=./shipping-documents
SHIPPING_DOCUMENT_MAX_BYTES=8388608
SUPPLIER_TO_ADMIN_TRANSIT_DAYS=14
ADMIN_TO_CUSTOMER_TRANSIT_DAYS=7
PREORDER_ESTIMATE_DAYS=21
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMTP (required when NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

INVENTORY_RESERVATION_TTL_MINUTES=30
ADMIN_PUSH_ENABLED=false
# Enable only with a persistent key created by scripts/ensure_admin_push_keys.py.
VAPID_PRIVATE_KEY_FILE=/app/push-keys/vapid-private.pem
VAPID_SUBJECT=https://shanicantik.com
