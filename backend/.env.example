# Runtime
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
ENFORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO

# Checkout and providers (mock is development-only)
PAYMENT_PROVIDER=click
CLICK_MODE=mock
CLICK_MOCK_SECRET_KEY=replace-with-a-local-test-secret
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_PAYMENT_URL=https://my.click.uz/services/pay
CLICK_RETURN_URL=http://localhost:3000/payment-pending
CLICK_API_BASE_URL=https://api.click.uz/v2/merchant/
SHIPPING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Media (local persistent volume is free; S3-compatible storage is optional)
MEDIA_STORAGE=local
MEDIA_ROOT=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMTP (required when NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

INVENTORY_RESERVATION_TTL_MINUTES=30
