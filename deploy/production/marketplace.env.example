# Copy to /etc/marketplace/marketplace.env on the VPS and chmod 600.
# Replace every <...> value. Do not commit the real file.

APP_ENV=production
DATABASE_URL=postgresql+asyncpg://marketplace:<database-password>@host.docker.internal:5432/marketplace
JWT_SECRET=<random-secret-at-least-32-characters>

FRONTEND_URL=https://shanicantik.com
CORS_ORIGINS=https://shanicantik.com,https://www.shanicantik.com
TRUSTED_HOSTS=shanicantik.com,www.shanicantik.com
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0

PAYMENT_PROVIDER=click
CLICK_MODE=test
CLICK_SERVICE_ID=<click-test-service-id>
CLICK_MERCHANT_ID=<click-test-merchant-id>
CLICK_MERCHANT_USER_ID=<click-test-merchant-user-id>
CLICK_SECRET_KEY=<click-test-secret-key>
CLICK_PAYMENT_URL=https://my.click.uz/services/pay
CLICK_API_BASE_URL=https://api.click.uz/v2/merchant/
CLICK_RETURN_URL=https://shanicantik.com/payment-pending

NOTIFICATION_PROVIDER=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<verified-sender-email>
SMTP_USE_TLS=true

# Shipping is a deterministic server-defined rate, not an external provider.
SHIPPING_PROVIDER=mock

MEDIA_STORAGE=local
MEDIA_ROOT=/app/uploads
INVENTORY_RESERVATION_TTL_MINUTES=30
LOG_LEVEL=INFO

# Bootstrap only: seed exactly one operator, then remove these two values if
# the deployment process does not need to retain them in the env file.
SEED_ADMIN_EMAIL=<operator-email>
SEED_ADMIN_PASSWORD=<strong-operator-password>
